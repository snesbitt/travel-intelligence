+// Pure: does this trip's return leg depart from a different city than the
+// outbound destination? (2026-08-11, open-jaw support, see watch.mjs's
+// validateTripInput for the storage-side validation that guarantees
+// returnFromIata is only ever set alongside a real returnDate.)
+export function isOpenJaw(trip) {
+  return Boolean(trip && trip.returnFromIata);
+}
+
+// Pure: build the SerpApi query params for an open-jaw trip's re-search,
+// a real 2-leg multi-city itinerary (type=3), the exact same
