+// sends for via/stopover routing -- not a new request format, just this
+// function's own trip fields mapped onto it.
+export function buildMultiCitySearchParams(trip, key) {
+  const legs = [
+    { departure_id: trip.originIata, arrival_id: trip.destIata, date: trip.departDate },
+    { departure_id: trip.returnFromIata, arrival_id: trip.originIata, date: trip.returnDate },
+  ];
